{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dogear.app/schema/book.schema.json",
  "title": "Dogear Book Record",
  "type": "object",
  "required": ["id","title","author","year","category","tags","difficulty","why_it_matters","crux","sparks","actions","not_for_you_if","verification"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "kebab-case slug of the title" },
    "title": { "type": "string", "minLength": 2, "maxLength": 120 },
    "subtitle": { "type": ["string","null"], "maxLength": 180 },
    "author": { "type": "string", "minLength": 2, "maxLength": 160 },
    "year": { "type": "integer", "minimum": -600, "maximum": 2026, "description": "year of first publication" },
    "category": { "type": "string" },
    "subcategory": { "type": "string", "maxLength": 60 },
    "tags": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "difficulty": { "enum": ["easy","moderate","challenging"] },
    "read_time_min": { "type": "integer", "minimum": 4, "maximum": 30 },
    "why_it_matters": { "type": "string", "minLength": 80, "maxLength": 320 },
    "crux": {
      "type": "object",
      "required": ["headline","body"],
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string", "minLength": 12, "maxLength": 70 },
        "body": { "type": "string", "minLength": 180, "maxLength": 520 }
      }
    },
    "sparks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id","hook","insight","why","apply","format","tags"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+-s(0[1-9]|1[0-2])$" },
          "hook": { "type": "string", "minLength": 14, "maxLength": 90 },
          "insight": { "type": "string", "minLength": 260, "maxLength": 700 },
          "why": { "type": "string", "minLength": 90, "maxLength": 300 },
          "apply": { "type": "string", "minLength": 60, "maxLength": 220 },
          "format": { "enum": ["single","carousel"] },
          "carousel": {
            "type": "array", "minItems": 3, "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["step","title","body"],
              "additionalProperties": false,
              "properties": {
                "step": { "type": "integer", "minimum": 1, "maximum": 5 },
                "title": { "type": "string", "minLength": 4, "maxLength": 48 },
                "body": { "type": "string", "minLength": 60, "maxLength": 260 }
              }
            }
          },
          "tags": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } }
        }
      }
    },
    "actions": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string", "minLength": 40, "maxLength": 200 } },
    "if_you_liked": { "type": "array", "maxItems": 4, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "not_for_you_if": { "type": "string", "minLength": 40, "maxLength": 220 },
    "verification": {
      "type": "object",
      "required": ["author_verified","year_verified","confidence"],
      "additionalProperties": false,
      "properties": {
        "author_verified": { "type": "boolean" },
        "year_verified": { "type": "boolean" },
        "confidence": { "enum": ["high","medium","low"] },
        "notes": { "type": ["string","null"], "maxLength": 400 }
      }
    }
  }
}
